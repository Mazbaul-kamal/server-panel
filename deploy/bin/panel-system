#!/usr/bin/env bash
set -euo pipefail

command="${1:?missing command}"

panel_root="/var/www/server-panel"
managed_root="/var/www/vhosts"

if [[ -r /etc/server-panel/root ]]; then
  panel_root="$(head -n 1 /etc/server-panel/root)"
fi

if [[ -r /etc/server-panel/managed-root ]]; then
  managed_root="$(head -n 1 /etc/server-panel/managed-root)"
fi

real_under() {
  local path="$1"
  local root="$2"
  local path_real
  local root_real

  path_real="$(realpath -m "$path")"
  root_real="$(realpath -m "$root")"

  [[ "$path_real/" == "$root_real/"* ]]
}

require_managed_child() {
  real_under "$1" "$managed_root" || exit 64
  [[ "$(realpath -m "$1")" != "$(realpath -m "$managed_root")" ]] || exit 64
}

require_owner() {
  [[ "$1" =~ ^[a-z_][a-z0-9_-]{0,31}(:[a-z_][a-z0-9_-]{0,31})?$ ]] || exit 64
}

require_git_repository() {
  [[ "$1" != *".."* ]] || exit 64
  [[ "$1" =~ ^https://[A-Za-z0-9._:-]+/[A-Za-z0-9._/-]+(\.git)?$ || "$1" =~ ^git@[A-Za-z0-9._-]+:[A-Za-z0-9._/-]+(\.git)?$ || "$1" =~ ^ssh://git@[A-Za-z0-9._-]+/[A-Za-z0-9._/-]+(\.git)?$ ]] || exit 64
}

require_git_branch() {
  [[ "$1" != -* ]] || exit 64
  [[ "$1" != *".."* ]] || exit 64
  [[ "$1" =~ ^[A-Za-z0-9._/-]{1,128}$ ]] || exit 64
}

allowed_module_packages() {
  case "$1" in
    websites) echo "nginx" ;;
    ssl) echo "certbot python3-certbot-nginx" ;;
    dns) echo "pdns-server pdns-backend-mysql" ;;
    databases) echo "mariadb-server phpmyadmin" ;;
    ftp) echo "pure-ftpd" ;;
    mail) echo "postfix dovecot-imapd dovecot-pop3d opendkim opendkim-tools rspamd" ;;
    webmail) echo "unzip" ;;
    email-delivery) echo "opendkim opendkim-tools rspamd" ;;
    email-marketing) echo "" ;;
    file-manager) echo "zip unzip acl" ;;
    php) echo "php-cli php-fpm php-mysql php-xml php-mbstring php-curl php-zip php-bcmath php-gd php-intl" ;;
    firewall) echo "ufw" ;;
    backups) echo "rsync tar gzip restic borgbackup" ;;
    docker) echo "docker.io docker-compose-plugin" ;;
    packages) echo "" ;;
    plugins) echo "" ;;
    web-terminal) echo "" ;;
    tuning) echo "sysstat" ;;
    high-availability) echo "rsync" ;;
    monitoring) echo "sysstat htop iotop" ;;
    ai-scanner) echo "clamav clamav-daemon" ;;
    bandwidth) echo "vnstat" ;;
    s3-backups) echo "restic rclone" ;;
    acl) echo "" ;;
    *) exit 64 ;;
  esac
}

require_service() {
  [[ "$1" =~ ^[a-zA-Z0-9@_.-]{1,96}$ ]] || exit 64

  case "$1" in
    nginx|mariadb|redis-server|supervisor|pdns|pure-ftpd|postfix|dovecot|opendkim|rspamd|docker|ufw|vnstat|sysstat|clamav-daemon|certbot.timer|php*-fpm|php-fpm) ;;
    *) exit 64 ;;
  esac
}

case "$command" in
  install-module)
    module="${2:?missing module}"
    [[ "$module" =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]] || exit 64
    packages="$(allowed_module_packages "$module")"

    if [[ -n "$packages" ]]; then
      /usr/bin/apt-get update
      /usr/bin/apt-get install -y $packages
    fi

    echo "Installed module packages for $module"
    ;;
  service)
    action="${2:?missing action}"
    unit="${3:?missing unit}"
    require_service "$unit"

    case "$action" in
      start|stop|restart|reload|enable|disable|status)
        /usr/bin/systemctl "$action" "$unit"
        ;;
      *)
        exit 64
        ;;
    esac
    ;;
  firewall)
    action="${2:?missing action}"
    port="${3:?missing port}"
    protocol="${4:?missing protocol}"
    source="${5:?missing source}"

    [[ "$port" =~ ^[0-9]{1,5}$ ]] && [[ "$port" -ge 1 ]] && [[ "$port" -le 65535 ]] || exit 64
    [[ "$protocol" =~ ^(tcp|udp)$ ]] || exit 64
    [[ "$source" =~ ^(any|[0-9a-fA-F:.\/]{3,64})$ ]] || exit 64

    /usr/sbin/ufw --force enable

    case "$action" in
      allow)
        if [[ "$source" == "any" ]]; then
          /usr/sbin/ufw allow "${port}/${protocol}"
        else
          /usr/sbin/ufw allow from "$source" to any port "$port" proto "$protocol"
        fi
        ;;
      deny)
        if [[ "$source" == "any" ]]; then
          /usr/sbin/ufw deny "${port}/${protocol}"
        else
          /usr/sbin/ufw deny from "$source" to any port "$port" proto "$protocol"
        fi
        ;;
      delete-allow)
        /usr/sbin/ufw --force delete allow "${port}/${protocol}" || true
        ;;
      delete-deny)
        /usr/sbin/ufw --force delete deny "${port}/${protocol}" || true
        ;;
      *)
        exit 64
        ;;
    esac
    ;;
  backup-path)
    source_path="${2:?missing source}"
    destination_path="${3:?missing destination}"
    retention_days="${4:?missing retention}"

    real_under "$source_path" "$managed_root" || exit 64
    real_under "$destination_path" /var/backups/server-panel || exit 64
    [[ "$retention_days" =~ ^[0-9]{1,4}$ ]] || exit 64

    timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
    /usr/bin/install -d -o root -g root -m 0750 "$destination_path"
    archive="$destination_path/backup-$timestamp.tar.gz"
    /usr/bin/tar -czf "$archive" -C "$(dirname "$source_path")" "$(basename "$source_path")"
    /usr/bin/find "$destination_path" -type f -name 'backup-*.tar.gz' -mtime "+$retention_days" -delete
    echo "Created $archive"
    ;;
  site-upload)
    archive_path="${2:?missing archive}"
    destination_path="${3:?missing destination}"
    owner="${4:?missing owner}"
    owner_user="${owner%%:*}"
    owner_group="www-data"
    storage_root="$panel_root/storage/app/private"
    archive_real="$(realpath "$archive_path")"
    tmp_dir="$(mktemp -d)"

    if [[ "$owner" == *:* ]]; then
      owner_group="${owner#*:}"
    fi

    require_owner "$owner"
    [[ -f "$archive_real" ]] || exit 64
    real_under "$archive_real" "$storage_root" || exit 64
    require_managed_child "$destination_path"

    cleanup_upload() {
      rm -rf "$tmp_dir"
    }
    trap cleanup_upload EXIT

    /usr/bin/install -d -o "$owner_user" -g "$owner_group" -m 0750 "$destination_path"
    /usr/bin/unzip -q "$archive_real" -d "$tmp_dir"
    /usr/bin/rsync -a --delete "$tmp_dir"/ "$destination_path"/
    /usr/bin/chown -R "$owner_user":"$owner_group" "$destination_path"
    /usr/bin/find "$destination_path" -type d -exec chmod 0750 {} +
    /usr/bin/find "$destination_path" -type f -exec chmod 0640 {} +
    echo "Uploaded archive to $destination_path"
    ;;
  git-deploy)
    repository="${2:?missing repository}"
    branch="${3:?missing branch}"
    destination_path="${4:?missing destination}"
    owner="${5:?missing owner}"
    deploy_key="${6:?missing deploy key}"
    owner_user="${owner%%:*}"
    owner_group="www-data"

    require_git_repository "$repository"
    require_git_branch "$branch"
    require_owner "$owner"
    require_managed_child "$destination_path"

    if [[ "$owner" == *:* ]]; then
      owner_group="${owner#*:}"
    fi

    if [[ "$deploy_key" != "-" ]]; then
      key_real="$(realpath "$deploy_key")"
      [[ -f "$key_real" ]] || exit 64
      real_under "$key_real" /etc/server-panel/deploy-keys || exit 64
      export GIT_SSH_COMMAND="ssh -i $key_real -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new"
    fi

    /usr/bin/install -d -o "$owner_user" -g "$owner_group" -m 0750 "$destination_path"

    if [[ -d "$destination_path/.git" ]]; then
      /usr/bin/git -C "$destination_path" fetch --prune origin "$branch"
      /usr/bin/git -C "$destination_path" checkout -B "$branch" FETCH_HEAD
      /usr/bin/git -C "$destination_path" reset --hard FETCH_HEAD
    else
      rm -rf "$destination_path"
      /usr/bin/git clone --depth 1 --branch "$branch" "$repository" "$destination_path"
    fi

    /usr/bin/chown -R "$owner_user":"$owner_group" "$destination_path"
    /usr/bin/find "$destination_path" -type d -exec chmod 0750 {} +
    /usr/bin/find "$destination_path" -type f -exec chmod 0640 {} +
    echo "Deployed $repository#$branch to $destination_path"
    ;;
  *)
    exit 64
    ;;
esac
